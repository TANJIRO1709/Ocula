# URL of the Ocula Node.js gateway (browser-visible). On Render this is derived automatically from API_HOST.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# MediaPipe face landmarker model (downloaded by the browser once, then cached by the service worker)
NEXT_PUBLIC_FACE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task
