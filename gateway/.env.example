NODE_ENV=development
PORT=8000
# Postgres (Render: use the database's Internal Database URL). Leave empty to use embedded PGlite in ./data
DATABASE_URL=
DATABASE_SSL=false
# Signs login tokens. Generate with: openssl rand -hex 32
SECRET_KEY=
# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# Public URL of the Next.js app (used in Vision Passport links / QR codes)
PUBLIC_BASE_URL=http://localhost:3000
# Public URL of this gateway (used for Twilio webhook URLs)
API_BASE_URL=http://localhost:8000
# FastAPI engine. ENGINE_API_KEY must equal ENGINE_API_KEY in engine/.env (openssl rand -hex 32)
ENGINE_URL=http://localhost:8001
ENGINE_API_KEY=
ADMIN_EMAIL=admin@ocula.app
# Required: no admin user is created while empty. Use a long random value.
ADMIN_PASSWORD=
# Optional Twilio (missed-call line + SMS). Console logging when empty.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
